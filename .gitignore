# ─────────────────────────────────────────────────────────────────────────────
log.lammps
log.coexistence
log.*
*.dump
*.cfg
*.lammpstrj
*.restart
*.restart.*
restart.*
*.data
perfect.data
*.bin
dump/

# ─────────────────────────────────────────────────────────────────────────────
# Potential and MLIP model files - obtain separately, too large for git
#   Place WMoNbZrTiTa.nist.adp.txt in the project root before running.
#   Place GRACE-2L-OMAT weights at the path set by GRACE_MODEL_DIR in config.py.
# ─────────────────────────────────────────────────────────────────────────────
*.adp.txt
*.pt
*.pth
*.model
*.npz
*.h5

